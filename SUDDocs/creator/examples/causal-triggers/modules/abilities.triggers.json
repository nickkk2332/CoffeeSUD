{
  "schema": 1,
  "id": "abilities.triggers",
  "title": "Causal triggers",
  "version": 1,
  "handler": "abilities.triggers",
  "clock_modes": ["TURNS", "REALTIME"],
  "scopes": ["character"],
  "on_disable": "suspend",
  "settings": {
    "action_budget": {"type": "integer", "default": 8, "min": 1, "max": 64},
    "max_depth": {"type": "integer", "default": 3, "min": 1, "max": 8}
  },
  "state": {
    "cooldowns": {"type": "string", "default": "", "max_length": 4096},
    "recent": {"type": "string", "default": "", "max_length": 4096}
  }
}
