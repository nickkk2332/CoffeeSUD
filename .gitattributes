# Auto detect text files and perform LF normalization
* text=auto

# cmd.exe needs CRLF line endings in batch files
*.bat text eol=crlf

# The flat-file database is random-access data addressed by byte offset,
# not text: converting its line endings corrupts it.
CoffeeMud/resources/fakedb/** binary
# World files are compared by checksum with what the database was built from,
# so they keep the same bytes on every platform
CoffeeMud/world/*.cmare text eol=lf
