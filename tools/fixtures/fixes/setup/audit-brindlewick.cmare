      <MTEXT xml="1">
       <NAME>the gate guard</NAME>
       <DESC>A young guard in a patched tabard. He watches the road and the gossip with equal attention.</DESC>
       <DISP>A gate guard leans on a long spear here.</DISP>
       <PROP ABILITY="11" ARMOR="88" ATTACK="6" DAMAGE="6" DISPOSITION="0" LEVEL="6" REJUV="0" SPEED="1.0" WEIGHT="179" HEIGHT="75" SENSES="0" />
