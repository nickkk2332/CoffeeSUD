        <BHAVE>
         <BCLASS>Scriptable</BCLASS>
         <BPARMS>GREET_PROG 100;if ispc($n);say Welcome to Brindlewick, $n. Harl the smith has lost his hammer. Say accept if you will help find it.;endif;~;SPEECH_PROG key storeroom;say The storeroom key? Harl keeps it in the oak chest in the well house, south of the green.;~;</BPARMS>
        </BHAVE>
