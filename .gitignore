# Build output (compiled in place; see CoffeeMud/build.sh)
*.class
CoffeeMud/.build-stamp
CoffeeMud/.build.log
CoffeeMud/.sources*.list

# Runtime logs
CoffeeMud/mud*.log

# Source list written by make.bat
CoffeeMud/sources.txt

# Saved games (see CoffeeMud/coffeemud.ini, SAVEDIR)
CoffeeMud/saves/

# Smoke test fixtures, copied in for a run (see tools/fixtures/smoke)
CoffeeMud/resources/quests/_smoke/

# The content database is a cache built from CoffeeMud/world (see
# core/save/WorldFiles.java); only its schema is kept
CoffeeMud/resources/fakedb/*
!CoffeeMud/resources/fakedb/fakedb.schema
