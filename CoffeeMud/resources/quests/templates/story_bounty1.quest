#!QUESTMAKER_START_SCRIPT Story Bounty #1
#!QUESTMAKER_MODE SINGLE
#A repeatable bounty for one player: an existing mob pays for a number of
#kills of mobs that fit a mask (wolves in the forest, say), counted as an
#objective, and offers the bounty again only after a cooldown on the game
#clock.  The player turns the bounty in to the giver.
#
#!QUESTMAKER_PAGE Quest Name/Criteria
#Enter the unique name and player criteria for your new quest.
#
#Quest ID:
#Enter a unique name/id for your quest:
#$QUEST_ID=$UNIQUE_QUEST_NAME=story_bounty_1
#
#Quest Name:
#Enter a friendly displayable name for your quest:
#$QUEST_NAME=$STRING=Wolf Bounty
#
#Quest-Player Criterium:
#You may leave this entry blank, or enter a Zapper Mask to describe what
#kinds of players may take this quest (race, level, and the rest).
#$QUEST_CRITERIA=$ZAPPERMASK
#
#Category:
#The kind of quest, which QUESTS groups by: main for the main story, or
#side, or any word.
#$CATEGORY=($STRING)=side
#
#!QUESTMAKER_PAGE Specify the Giver
#The Giver is the existing mob who offers the quest, with a yes/no
#question when the player meets them.
#
#Area and room:
#The area and/or room the mob is in.  You may leave both blank to have
#the quest find the mob anywhere in the world.
#Use double-quotes around multi-word areas and room ids/names.
#Giver Area:
#$GIVER_AREA=($AREA)
#Giver Room ID:
#$GIVER_ROOM=($ROOMID)
#
#Giver mob name:
#Use double-quotes around multi-word names.
#$GIVER_NAME=$NAME
#
#Offer:
#What the Giver says when offering the quest.
#$QUEST_NOTIFYSTRING=$LONG_STRING=The wolves are at the flocks again.  I pay for every pelt.
#
#Instructions:
#What the player is told to do, shown by QUESTS.
#$QUEST_INSTRUCTIONSSTRING=$LONG_STRING=Kill the wolves, then come back to be paid.
#
#!QUESTMAKER_PAGE The Bounty
#Which mobs count, as a Zapper Mask (see AHELP ZAPPERMASKS):
#$TARGET_MASK=$ZAPPERMASK
#
#The objective shown by QUESTS:
#$TARGET_OBJECTIVE=$STRING=Kill wolves
#
#How many:
#$TARGET_COUNT=$EXPRESSION=5
#
#How long before the bounty may be taken again, on the game clock:
#$COOLDOWN=$STRING=1 mudday
#
#What the Giver says on paying:
#$PAY_TEXT=($LONG_STRING)=Good work.  Here is what I owe you.
#
#!QUESTMAKER_PAGE Quest Completion
#The reward, in the words of SET REWARDS: 100 CURRENCY, 50 XP, 10% XP (of
#a level), 2 QP, FACTION:[ID]:+[N], ITEM:[CATALOG NAME], and the
#achievements' award words.  Leave it blank for none.
#$REWARDS=($STRING)=100 CURRENCY
#
#Journal entry when the quest is taken on:
#$JOURNAL_START=($LONG_STRING)=I took on a bounty.
#
#Journal entry when it is done:
#$JOURNAL_DONE=($LONG_STRING)=I was paid the bounty.
#
#!QUESTMAKER_END_SCRIPT Story Bounty #1

set name $QUEST_ID
set display $QUEST_NAME
set author $#AUTHOR
set questtype story_bounty1
set category $CATEGORY
set instructions $QUEST_INSTRUCTIONSSTRING
set rewards "$REWARDS"
set repeatable $COOLDOWN

set area $GIVER_AREA
set room $GIVER_ROOM
set mobgroup
set mob reselect $GIVER_NAME
give stat keyplayer true
give script LOAD=$QUEST_ID_giver.script
give affect Prop_QuestGiver QUEST="$QUEST_ID" TRIGGER=ENTER REOFFER=ALWAYS
give affect Prop_QuestMarker QUEST=$QUEST_ID READYFUNC=CAN_COMPLETE

set duration 0

<?xml version="1.0"?>
<FILE><NAME>$QUEST_ID_giver.script</NAME>
<DATA>
FUNCTION_PROG CAN_ACCEPT
	if ISLIKE($n '$QUEST_CRITERIA') and ISPC($n) and !QUESTSCRIPTED($n *)
		RETURN TRUE
	endif
	RETURN CANCEL
~

FUNCTION_PROG DO_ACCEPT
	mpscript $n INDIVIDUAL SAVABLE STATIC=LOAD=$QUEST_ID_playertrack.script
	mpqobjective $n * ADD kills $TARGET_COUNT $TARGET_OBJECTIVE
	mpqjournal $n * $JOURNAL_START
	mpqset * STATISTICS ACCEPTED
~

SPEECH_PROG p i accept
	if CALLFUNC(CAN_ACCEPT)
		sayto "$n" $QUEST_INSTRUCTIONSSTRING
		MPCALLFUNC DO_ACCEPT
	endif
~

FUNCTION_PROG CAN_COMPLETE
	if QUESTSCRIPTED($n *) and QOBJECTIVE($n * kills == DONE)
		RETURN TRUE
	endif
~

GREET_PROG 100
	if ISPC($n) and QUESTSCRIPTED($n *) and QOBJECTIVE($n * kills == DONE)
		sayto "$n" $PAY_TEXT
		mpqjournal $n * $JOURNAL_DONE
		mpquestwin $n * REWARD
		mpendquest $n
		mpqset * STATISTICS SUCCESS
	endif
~
</DATA></FILE>
<FILE><NAME>$QUEST_ID_playertrack.script</NAME>
<DATA>
ONCE_PROG 100
	mpsetvar $i INSTRUCTIONS $QUEST_INSTRUCTIONSSTRING
~

EXECMSG_PROG STO=DEATH ALL
	if ISNPC($n) and ISLIKE($n '$TARGET_MASK') and !QOBJECTIVE($i * kills == DONE)
		mpqobjective $i * BUMP kills
	endif
~
</DATA></FILE>
