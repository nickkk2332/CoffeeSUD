<ROOM id="leaf_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='leaf'">
	<ROOM select="all" condition="$theme='volcano' or $theme='random'">
		<ROOM class="CaveRoom" condition="$roomtag_isdeepest='true' and $__volcanoboss&lt;1" define="__volcanoboss+=1">
			<TITLE>an obsidian grotto, the deepest place</TITLE>
			<DESCRIPTION>Sharp obsidian juts from the walls of this grotto. It is a dead end. This is the heart of $areaname. You can go $roomexits_desc_long.</DESCRIPTION>
			<EXIT class="Open" />
			<MOB insert="volcano_boss" condition="$pop_mobs!='false'" />
			<ITEM select="any-3" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
		</ROOM>
		<ROOM class="CaveRoom">
			<TITLE>an obsidian grotto</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Sharp obsidian juts from the walls of this grotto. </DESCRIPTION>
					<DESCRIPTION>Hot smoke pours from a vent in the floor here. </DESCRIPTION>
					<DESCRIPTION>Red crystals line this hollow like the inside of a geode. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>It is a dead end. </DESCRIPTION>
					<DESCRIPTION>The rock here is too hot to touch. </DESCRIPTION>
					<DESCRIPTION>Something glitters among the stones. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="volcano_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="volcano_junk" />
			<ITEM condition="(1?3=1) and ($pop_items!='false')" select="any-2" insert="dungeon_treasure_items" />
		</ROOM>
		<ROOM class="CaveRoom">
			<TITLE>a smoking vent</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
