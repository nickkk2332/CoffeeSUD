			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="volcano_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="volcano_junk" />
