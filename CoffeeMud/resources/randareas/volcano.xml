See guides/RandomAreas.html for information about documents of this type.

G15: the volcano theme, a volcano: fiery craters, magma caves and the forges of fire cults.  GENERATE AREA volcano_dungeon FROM randareas/volcano.xml areaname=X
areasize=30 level_range=10 aggrochance=20 theme=volcano; random_dungeon rolls it too.
-->
<string id="randomtheme" merge="true" select="any-1">
	<string condition="$theme=''">volcano</string>
</string>
<STRING load="/resources/randareas/inc_roomruns.xml" />
<STRING load="/resources/randareas/inc_common.xml" />
<STRING load="/resources/randareas/inc_adjectives.xml" />
<STRING load="/resources/randareas/inc_setpieces.xml" />

<!-- the theme's own area: its layout picked from the list (G16), its name once in requires -->
<AREA id="volcano_dungeon" layout="CAVE,TREE,BRANCH,LINEAR,MAZE" requires="areaname=$,areasize=int,level_range=int,aggrochance=int,theme=volcano">
	<NAME>$areaname</NAME><SIZE>$areasize</SIZE>
	<CLASS select="any-1"><CLASS condition="$areatype!=''">$areatype</CLASS><CLASS condition="$areatype=''">StdArea</CLASS></CLASS>
	<ROOM insert="hallway_rooms,interior_rooms,leaf_rooms" />
</AREA>
<AREA id="random_dungeon" merge="true" insert="volcano_dungeon" />

<ROOM id="hallway_rooms" merge="true" select="pick-1" condition="$roomtag_nodetype='street' or $roomtag_nodetype='surround'">
	<ROOM select="all" condition="$theme='volcano' or $theme='random'">
		<ROOM class="CaveRoom">
			<TITLE>a cracked lava tube</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The walls of this old lava tube glow a dull red. </DESCRIPTION>
					<DESCRIPTION>A narrow ledge runs above a river of slow magma. </DESCRIPTION>
					<DESCRIPTION>Yellow sulphur crusts the walls of this hot fissure. </DESCRIPTION>
					<DESCRIPTION>The ground here is warm, and cracked with veins of fire. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Heat shimmers in the air. </DESCRIPTION>
					<DESCRIPTION>Ash drifts down like grey snow. </DESCRIPTION>
					<DESCRIPTION>Somewhere below, the rock rumbles. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="volcano_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="volcano_junk" />
		</ROOM>
		<ROOM class="CaveRoom">
			<TITLE>a ledge above a magma river</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The walls of this old lava tube glow a dull red. </DESCRIPTION>
					<DESCRIPTION>A narrow ledge runs above a river of slow magma. </DESCRIPTION>
					<DESCRIPTION>Yellow sulphur crusts the walls of this hot fissure. </DESCRIPTION>
					<DESCRIPTION>The ground here is warm, and cracked with veins of fire. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Heat shimmers in the air. </DESCRIPTION>
					<DESCRIPTION>Ash drifts down like grey snow. </DESCRIPTION>
					<DESCRIPTION>Somewhere below, the rock rumbles. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="volcano_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="volcano_junk" />
		</ROOM>
		<ROOM class="CaveRoom">
			<TITLE>a sulphurous fissure</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The walls of this old lava tube glow a dull red. </DESCRIPTION>
					<DESCRIPTION>A narrow ledge runs above a river of slow magma. </DESCRIPTION>
					<DESCRIPTION>Yellow sulphur crusts the walls of this hot fissure. </DESCRIPTION>
					<DESCRIPTION>The ground here is warm, and cracked with veins of fire. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Heat shimmers in the air. </DESCRIPTION>
					<DESCRIPTION>Ash drifts down like grey snow. </DESCRIPTION>
					<DESCRIPTION>Somewhere below, the rock rumbles. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="volcano_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="volcano_junk" />
		</ROOM>
		<ROOM insert="setpiece_hall_rooms" />
	</ROOM>
</ROOM>

<ROOM id="interior_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='interior' or $roomtag_nodetype='square'">
