</ROOM>

<MOB id="volcano_mobs" select="any-1" requires="level_range=int,aggrochance=int">
	<MOB class="GenMob" level="$level_range" race="FireElemental" gender="$anygender">
		<NAME>a living flame</NAME>
		<DISPLAY>$mob_name flickers and roars.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="MagmaMephit" gender="$anygender">
		<NAME>a magma mephit</NAME>
		<DISPLAY>$mob_name drips molten rock.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Demon" gender="$anygender">
		<NAME>a lesser fire demon</NAME>
		<DISPLAY>$mob_name grins through the smoke.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="GreatLizard" gender="$anygender">
		<NAME>a salamander</NAME>
		<DISPLAY>$mob_name basks in the heat.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
</MOB>

<MOB id="volcano_boss" class="GenMob" level="$level_range + 5" race="Giant" gender="$anygender" hpmod="25">
	<NAME>a fire giant</NAME>
	<DISPLAY>$mob_name hammers at a glowing anvil.</DISPLAY>
	<BEHAVIOR select="all">
		<BEHAVIOR class="Aggressive" parms="" condition="$aggrochance&gt;0" />
		<BEHAVIOR class="CombatAbilities" parms="" />
	</BEHAVIOR>
	<ITEM select="any-2" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
</MOB>

<ITEM id="volcano_junk" select="any-1">
	<ITEM class="GenItem" name="a chunk of obsidian" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a lump of sulphur" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a cooled lava stone" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a cracked forge tongs" display="$item_name lies here." level="$level_range" basegold="1?20" />
</ITEM>
