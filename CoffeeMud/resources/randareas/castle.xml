See guides/RandomAreas.html for information about documents of this type.

G15: the castle theme, a castle or fortress: draughty keeps and war-torn halls.  GENERATE AREA castle_dungeon FROM randareas/castle.xml areaname=X
areasize=30 level_range=10 aggrochance=20 theme=castle; random_dungeon rolls it too.
-->
<string id="randomtheme" merge="true" select="any-1">
	<string condition="$theme=''">castle</string>
</string>
<STRING load="/resources/randareas/inc_roomruns.xml" />
<STRING load="/resources/randareas/inc_common.xml" />
<STRING load="/resources/randareas/inc_adjectives.xml" />
<STRING load="/resources/randareas/inc_setpieces.xml" />

<!-- the theme's own area: its layout picked from the list (G16), its name once in requires -->
<AREA id="castle_dungeon" layout="BOXCITY,BOXCITYSQUARE,RING,CROSS,APARTMENT" requires="areaname=$,areasize=int,level_range=int,aggrochance=int,theme=castle">
	<NAME>$areaname</NAME><SIZE>$areasize</SIZE>
	<CLASS select="any-1"><CLASS condition="$areatype!=''">$areatype</CLASS><CLASS condition="$areatype=''">StdArea</CLASS></CLASS>
	<ROOM insert="hallway_rooms,interior_rooms,leaf_rooms" />
</AREA>
<AREA id="random_dungeon" merge="true" insert="castle_dungeon" />

<ROOM id="hallway_rooms" merge="true" select="pick-1" condition="$roomtag_nodetype='street' or $roomtag_nodetype='surround'">
	<ROOM select="all" condition="$theme='castle' or $theme='random'">
		<ROOM class="StoneRoom">
			<TITLE>a draughty corridor</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Torch brackets line this draughty stone corridor. </DESCRIPTION>
					<DESCRIPTION>Faded tapestries of old battles hang along this gallery. </DESCRIPTION>
					<DESCRIPTION>A narrow landing turns here between the castle's floors. </DESCRIPTION>
					<DESCRIPTION>Arrow slits let thin light into this passage. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The floor is worn smooth by many boots. </DESCRIPTION>
					<DESCRIPTION>A banner lies torn on the flagstones. </DESCRIPTION>
					<DESCRIPTION>Cold drafts whistle through. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="castle_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="castle_junk" />
		</ROOM>
		<ROOM class="StoneRoom">
			<TITLE>a gallery of faded tapestries</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Torch brackets line this draughty stone corridor. </DESCRIPTION>
					<DESCRIPTION>Faded tapestries of old battles hang along this gallery. </DESCRIPTION>
					<DESCRIPTION>A narrow landing turns here between the castle's floors. </DESCRIPTION>
					<DESCRIPTION>Arrow slits let thin light into this passage. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The floor is worn smooth by many boots. </DESCRIPTION>
					<DESCRIPTION>A banner lies torn on the flagstones. </DESCRIPTION>
					<DESCRIPTION>Cold drafts whistle through. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="castle_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="castle_junk" />
		</ROOM>
		<ROOM class="StoneRoom">
			<TITLE>a stair landing</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Torch brackets line this draughty stone corridor. </DESCRIPTION>
					<DESCRIPTION>Faded tapestries of old battles hang along this gallery. </DESCRIPTION>
					<DESCRIPTION>A narrow landing turns here between the castle's floors. </DESCRIPTION>
					<DESCRIPTION>Arrow slits let thin light into this passage. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The floor is worn smooth by many boots. </DESCRIPTION>
					<DESCRIPTION>A banner lies torn on the flagstones. </DESCRIPTION>
					<DESCRIPTION>Cold drafts whistle through. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="castle_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="castle_junk" />
		</ROOM>
		<ROOM insert="setpiece_hall_rooms" />
	</ROOM>
</ROOM>

