<ROOM id="leaf_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='leaf'">
	<ROOM select="all" condition="$theme='castle' or $theme='random'">
		<ROOM class="StoneRoom" condition="$roomtag_isdeepest='true' and $__castleboss&lt;1" define="__castleboss+=1">
			<TITLE>a lord's bedchamber, the deepest place</TITLE>
			<DESCRIPTION>A great canopied bed rots in this chamber. A chest stands at the foot of the bed. This is the heart of $areaname. You can go $roomexits_desc_long.</DESCRIPTION>
			<EXIT class="Open" />
			<MOB insert="castle_boss" condition="$pop_mobs!='false'" />
			<ITEM select="any-3" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
		</ROOM>
		<ROOM class="StoneRoom">
			<TITLE>a lord's bedchamber</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A great canopied bed rots in this chamber. </DESCRIPTION>
					<DESCRIPTION>Pews face a small altar in this dusty chapel. </DESCRIPTION>
					<DESCRIPTION>This private solar has a view over the walls. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A chest stands at the foot of the bed. </DESCRIPTION>
					<DESCRIPTION>The stained glass is cracked. </DESCRIPTION>
					<DESCRIPTION>Books lie open on the desk. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="castle_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="castle_junk" />
			<ITEM condition="(1?3=1) and ($pop_items!='false')" select="any-2" insert="dungeon_treasure_items" />
		</ROOM>
		<ROOM class="StoneRoom">
			<TITLE>a dusty chapel</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
