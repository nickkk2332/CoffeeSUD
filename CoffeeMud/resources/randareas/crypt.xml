<MOB id="crypt_mobs" select="any-1" requires="level_range=int,aggrochance=int">
	<MOB class="GenMob" level="$level_range" race="Skeleton" gender="$anygender">
		<NAME>(a(n)) $adj_ragged skeleton</NAME>
		<DISPLAY>$mob_name rattles as it moves.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Zombie" gender="$anygender">
		<NAME>(a(n)) $adj_filthy zombie</NAME>
		<DISPLAY>$mob_name shambles about here.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Ghoul" gender="$anygender">
		<NAME>a hungry ghoul</NAME>
		<DISPLAY>$mob_name crouches over a pile of bones.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Ghost" gender="$anygender">
		<NAME>a restless ghost</NAME>
		<DISPLAY>$mob_name drifts through the stone.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
</MOB>

<MOB id="crypt_boss" class="GenMob" level="$level_range + 5" race="Lich" gender="$anygender" hpmod="25">
	<NAME>the master of the crypt</NAME>
	<DISPLAY>$mob_name, a robed lich, watches from the shadows.</DISPLAY>
	<BEHAVIOR select="all">
		<BEHAVIOR class="Aggressive" parms="" condition="$aggrochance&gt;0" />
		<BEHAVIOR class="CombatAbilities" parms="" />
	</BEHAVIOR>
	<ITEM select="any-2" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
</MOB>

<ITEM id="crypt_junk" select="any-1">
	<ITEM class="GenItem" name="a cracked funerary urn" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a tarnished burial coin" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a moldering shroud" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a carved bone charm" display="$item_name lies here." level="$level_range" basegold="1?20" />
</ITEM>
