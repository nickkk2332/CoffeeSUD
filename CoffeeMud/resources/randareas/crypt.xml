See guides/RandomAreas.html for information about documents of this type.

G15: the crypt theme, a crypt or graveyard: catacombs and mausoleums of the restless dead.  GENERATE AREA crypt_dungeon FROM randareas/crypt.xml areaname=X
areasize=30 level_range=10 aggrochance=20 theme=crypt; random_dungeon rolls it too.
-->
<string id="randomtheme" merge="true" select="any-1">
	<string condition="$theme=''">crypt</string>
</string>
<STRING load="/resources/randareas/inc_roomruns.xml" />
<STRING load="/resources/randareas/inc_common.xml" />
<STRING load="/resources/randareas/inc_adjectives.xml" />
<STRING load="/resources/randareas/inc_setpieces.xml" />

<!-- the theme's own area: its layout picked from the list (G16), its name once in requires -->
<AREA id="crypt_dungeon" layout="MAZE,TREE,BRANCH,CLUMP,CAVE" requires="areaname=$,areasize=int,level_range=int,aggrochance=int,theme=crypt">
	<NAME>$areaname</NAME><SIZE>$areasize</SIZE>
	<CLASS select="any-1"><CLASS condition="$areatype!=''">$areatype</CLASS><CLASS condition="$areatype=''">StdArea</CLASS></CLASS>
	<ROOM insert="hallway_rooms,interior_rooms,leaf_rooms" />
</AREA>
<AREA id="random_dungeon" merge="true" insert="crypt_dungeon" />

<ROOM id="hallway_rooms" merge="true" select="pick-1" condition="$roomtag_nodetype='street' or $roomtag_nodetype='surround'">
	<ROOM select="all" condition="$theme='crypt' or $theme='random'">
		<ROOM class="DarkStoneRoom">
			<TITLE>a burial corridor</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Skulls stare from the niches along this $adj_mustydark corridor. </DESCRIPTION>
					<DESCRIPTION>The walls here are stacked with old bones, $adj_carelessly piled. </DESCRIPTION>
					<DESCRIPTION>A $adj_faint smell of decay hangs in this $adj_cramped passage. </DESCRIPTION>
					<DESCRIPTION>Faded names are carved above each burial niche. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Dust lies thick and undisturbed. </DESCRIPTION>
					<DESCRIPTION>Something has gnawed at the bones. </DESCRIPTION>
					<DESCRIPTION>Cold air moves though no wind blows. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="crypt_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="crypt_junk" />
		</ROOM>
		<ROOM class="DarkStoneRoom">
			<TITLE>a passage lined with niches</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Skulls stare from the niches along this $adj_mustydark corridor. </DESCRIPTION>
					<DESCRIPTION>The walls here are stacked with old bones, $adj_carelessly piled. </DESCRIPTION>
					<DESCRIPTION>A $adj_faint smell of decay hangs in this $adj_cramped passage. </DESCRIPTION>
					<DESCRIPTION>Faded names are carved above each burial niche. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Dust lies thick and undisturbed. </DESCRIPTION>
					<DESCRIPTION>Something has gnawed at the bones. </DESCRIPTION>
					<DESCRIPTION>Cold air moves though no wind blows. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="crypt_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="crypt_junk" />
		</ROOM>
		<ROOM class="DarkStoneRoom">
			<TITLE>a crumbling ossuary walk</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Skulls stare from the niches along this $adj_mustydark corridor. </DESCRIPTION>
					<DESCRIPTION>The walls here are stacked with old bones, $adj_carelessly piled. </DESCRIPTION>
					<DESCRIPTION>A $adj_faint smell of decay hangs in this $adj_cramped passage. </DESCRIPTION>
					<DESCRIPTION>Faded names are carved above each burial niche. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Dust lies thick and undisturbed. </DESCRIPTION>
					<DESCRIPTION>Something has gnawed at the bones. </DESCRIPTION>
					<DESCRIPTION>Cold air moves though no wind blows. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="crypt_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="crypt_junk" />
		</ROOM>
		<ROOM insert="setpiece_hall_rooms" />
	</ROOM>
</ROOM>

