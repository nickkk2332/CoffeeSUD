<ROOM id="leaf_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='leaf'">
	<ROOM select="all" condition="$theme='crypt' or $theme='random'">
		<ROOM class="DarkStoneRoom" condition="$roomtag_isdeepest='true' and $__cryptboss&lt;1" define="__cryptboss+=1">
			<TITLE>a sealed tomb, the deepest place</TITLE>
			<DESCRIPTION>This tomb was sealed long ago, and the air is stale. Grave goods lie scattered about. This is the heart of $areaname. You can go $roomexits_desc_long.</DESCRIPTION>
			<EXIT class="Open" />
			<MOB insert="crypt_boss" condition="$pop_mobs!='false'" />
			<ITEM select="any-3" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
		</ROOM>
		<ROOM class="DarkStoneRoom">
			<TITLE>a sealed tomb</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>This tomb was sealed long ago, and the air is stale. </DESCRIPTION>
					<DESCRIPTION>A single sarcophagus fills this $adj_cramped room. </DESCRIPTION>
					<DESCRIPTION>Jars and hooks of the embalmer's trade line these shelves. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Grave goods lie scattered about. </DESCRIPTION>
					<DESCRIPTION>The carvings show the dead rising. </DESCRIPTION>
					<DESCRIPTION>Bones crunch underfoot. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="crypt_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="crypt_junk" />
			<ITEM condition="(1?3=1) and ($pop_items!='false')" select="any-2" insert="dungeon_treasure_items" />
		</ROOM>
		<ROOM class="DarkStoneRoom">
			<TITLE>a forgotten burial niche</TITLE>
