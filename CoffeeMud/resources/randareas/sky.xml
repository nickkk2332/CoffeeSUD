<ROOM id="leaf_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='leaf'">
	<ROOM select="all" condition="$theme='sky' or $theme='random'">
		<ROOM class="Hills" condition="$roomtag_isdeepest='true' and $__skyboss&lt;1" define="__skyboss+=1">
			<TITLE>a floating crag, the deepest place</TITLE>
			<DESCRIPTION>A lone crag floats here, joined to the rest by a single span. The edge drops away into empty sky. This is the heart of $areaname. You can go $roomexits_desc_long.</DESCRIPTION>
			<EXIT class="Open" />
			<MOB insert="sky_boss" condition="$pop_mobs!='false'" />
			<ITEM select="any-3" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
		</ROOM>
		<ROOM class="Hills">
			<TITLE>a floating crag</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A lone crag floats here, joined to the rest by a single span. </DESCRIPTION>
					<DESCRIPTION>Bones and shiny trinkets fill this great nest. </DESCRIPTION>
					<DESCRIPTION>Wind chimes ring endlessly in this little shrine. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The edge drops away into empty sky. </DESCRIPTION>
					<DESCRIPTION>Something has hoarded treasure here. </DESCRIPTION>
					<DESCRIPTION>The view is dizzying. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
