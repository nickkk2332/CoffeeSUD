See guides/RandomAreas.html for information about documents of this type.

G15: the sky theme, the sky: floating islands, storm temples and aerial lairs.  GENERATE AREA sky_dungeon FROM randareas/sky.xml areaname=X
areasize=30 level_range=10 aggrochance=20 theme=sky; random_dungeon rolls it too.
-->
<string id="randomtheme" merge="true" select="any-1">
	<string condition="$theme=''">sky</string>
</string>
<STRING load="/resources/randareas/inc_roomruns.xml" />
<STRING load="/resources/randareas/inc_common.xml" />
<STRING load="/resources/randareas/inc_adjectives.xml" />
<STRING load="/resources/randareas/inc_setpieces.xml" />

<!-- the theme's own area: its layout picked from the list (G16), its name once in requires -->
<AREA id="sky_dungeon" layout="ISLANDS,RING,SPOTTEDMESH,LINEAR,CLUMP" requires="areaname=$,areasize=int,level_range=int,aggrochance=int,theme=sky">
	<NAME>$areaname</NAME><SIZE>$areasize</SIZE>
	<CLASS select="any-1"><CLASS condition="$areatype!=''">$areatype</CLASS><CLASS condition="$areatype=''">StdArea</CLASS></CLASS>
	<ROOM insert="hallway_rooms,interior_rooms,leaf_rooms" />
</AREA>
<AREA id="random_dungeon" merge="true" insert="sky_dungeon" />

<ROOM id="hallway_rooms" merge="true" select="pick-1" condition="$roomtag_nodetype='street' or $roomtag_nodetype='surround'">
	<ROOM select="all" condition="$theme='sky' or $theme='random'">
		<ROOM class="Hills">
			<TITLE>a windswept rope bridge</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A rope bridge sways between two floating rocks. </DESCRIPTION>
					<DESCRIPTION>This path runs along the edge of a floating island, over nothing. </DESCRIPTION>
					<DESCRIPTION>Steps cut into the rock climb through the clouds. </DESCRIPTION>
					<DESCRIPTION>Wind howls across this exposed ridge high above the world. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Far below, the land is a patchwork of fields. </DESCRIPTION>
					<DESCRIPTION>Clouds drift past close enough to touch. </DESCRIPTION>
					<DESCRIPTION>Birds wheel in the open air below you. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="sky_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="sky_junk" />
		</ROOM>
		<ROOM class="Hills">
			<TITLE>a path along a floating isle</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A rope bridge sways between two floating rocks. </DESCRIPTION>
					<DESCRIPTION>This path runs along the edge of a floating island, over nothing. </DESCRIPTION>
					<DESCRIPTION>Steps cut into the rock climb through the clouds. </DESCRIPTION>
					<DESCRIPTION>Wind howls across this exposed ridge high above the world. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Far below, the land is a patchwork of fields. </DESCRIPTION>
					<DESCRIPTION>Clouds drift past close enough to touch. </DESCRIPTION>
					<DESCRIPTION>Birds wheel in the open air below you. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="sky_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="sky_junk" />
		</ROOM>
		<ROOM class="Hills">
			<TITLE>a cloud-wreathed stair</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A rope bridge sways between two floating rocks. </DESCRIPTION>
					<DESCRIPTION>This path runs along the edge of a floating island, over nothing. </DESCRIPTION>
					<DESCRIPTION>Steps cut into the rock climb through the clouds. </DESCRIPTION>
					<DESCRIPTION>Wind howls across this exposed ridge high above the world. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Far below, the land is a patchwork of fields. </DESCRIPTION>
					<DESCRIPTION>Clouds drift past close enough to touch. </DESCRIPTION>
					<DESCRIPTION>Birds wheel in the open air below you. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="sky_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="sky_junk" />
		</ROOM>
		<ROOM insert="setpiece_hall_rooms" />
	</ROOM>
</ROOM>

