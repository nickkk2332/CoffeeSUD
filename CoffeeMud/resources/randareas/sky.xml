<MOB id="sky_mobs" select="any-1" requires="level_range=int,aggrochance=int">
	<MOB class="GenMob" level="$level_range" race="Harpy" gender="$anygender">
		<NAME>a shrieking harpy</NAME>
		<DISPLAY>$mob_name circles overhead.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Griffon" gender="$anygender">
		<NAME>a griffon</NAME>
		<DISPLAY>$mob_name preens its feathers.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="AirElemental" gender="$anygender">
		<NAME>a gust of living wind</NAME>
		<DISPLAY>$mob_name whirls about.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="GreatBird" gender="$anygender">
		<NAME>a storm eagle</NAME>
		<DISPLAY>$mob_name watches you from a high perch.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
</MOB>

<MOB id="sky_boss" class="GenMob" level="$level_range + 5" race="Giant" gender="$anygender" hpmod="25">
	<NAME>a cloud giant</NAME>
	<DISPLAY>$mob_name sits on a throne of carved cloud-stone.</DISPLAY>
	<BEHAVIOR select="all">
		<BEHAVIOR class="Aggressive" parms="" condition="$aggrochance&gt;0" />
		<BEHAVIOR class="CombatAbilities" parms="" />
	</BEHAVIOR>
	<ITEM select="any-2" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
</MOB>

<ITEM id="sky_junk" select="any-1">
	<ITEM class="GenItem" name="a storm-blue feather" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a bit of cloud crystal" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a brass wind chime" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a frayed length of rope" display="$item_name lies here." level="$level_range" basegold="1?20" />
</ITEM>
