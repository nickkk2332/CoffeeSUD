G15: the mine theme, a mine: timbered shafts, ore chambers and the things that dig there.  GENERATE AREA mine_dungeon FROM randareas/mine.xml areaname=X
areasize=30 level_range=10 aggrochance=20 theme=mine; random_dungeon rolls it too.
-->
<string id="randomtheme" merge="true" select="any-1">
	<string condition="$theme=''">mine</string>
</string>
<STRING load="/resources/randareas/inc_roomruns.xml" />
<STRING load="/resources/randareas/inc_common.xml" />
<STRING load="/resources/randareas/inc_adjectives.xml" />
<STRING load="/resources/randareas/inc_setpieces.xml" />

<!-- the theme's own area: its layout picked from the list (G16), its name once in requires -->
<AREA id="mine_dungeon" layout="LINEAR,TREE,BRANCH,CAVE,MAZE" requires="areaname=$,areasize=int,level_range=int,aggrochance=int,theme=mine">
	<NAME>$areaname</NAME><SIZE>$areasize</SIZE>
	<CLASS select="any-1"><CLASS condition="$areatype!=''">$areatype</CLASS><CLASS condition="$areatype=''">StdArea</CLASS></CLASS>
	<ROOM insert="hallway_rooms,interior_rooms,leaf_rooms" />
</AREA>
<AREA id="random_dungeon" merge="true" insert="mine_dungeon" />

<ROOM id="hallway_rooms" merge="true" select="pick-1" condition="$roomtag_nodetype='street' or $roomtag_nodetype='surround'">
	<ROOM select="all" condition="$theme='mine' or $theme='random'">
		<ROOM class="CaveRoom">
			<TITLE>a timbered shaft</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Old timbers prop up the roof of this shaft. </DESCRIPTION>
					<DESCRIPTION>Rusted rails run along the floor of this tunnel. </DESCRIPTION>
					<DESCRIPTION>This seam is barely wide enough to squeeze through. </DESCRIPTION>
					<DESCRIPTION>Pick marks scar every wall of this passage. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Dust trickles from the ceiling. </DESCRIPTION>
					<DESCRIPTION>An overturned ore cart blocks part of the way. </DESCRIPTION>
					<DESCRIPTION>Water drips somewhere in the dark. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="mine_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="mine_junk" />
		</ROOM>
		<ROOM class="CaveRoom">
			<TITLE>a rail-cart tunnel</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Old timbers prop up the roof of this shaft. </DESCRIPTION>
					<DESCRIPTION>Rusted rails run along the floor of this tunnel. </DESCRIPTION>
					<DESCRIPTION>This seam is barely wide enough to squeeze through. </DESCRIPTION>
					<DESCRIPTION>Pick marks scar every wall of this passage. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Dust trickles from the ceiling. </DESCRIPTION>
					<DESCRIPTION>An overturned ore cart blocks part of the way. </DESCRIPTION>
					<DESCRIPTION>Water drips somewhere in the dark. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="mine_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="mine_junk" />
		</ROOM>
		<ROOM class="CaveRoom">
			<TITLE>a narrow seam</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Old timbers prop up the roof of this shaft. </DESCRIPTION>
					<DESCRIPTION>Rusted rails run along the floor of this tunnel. </DESCRIPTION>
					<DESCRIPTION>This seam is barely wide enough to squeeze through. </DESCRIPTION>
					<DESCRIPTION>Pick marks scar every wall of this passage. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Dust trickles from the ceiling. </DESCRIPTION>
					<DESCRIPTION>An overturned ore cart blocks part of the way. </DESCRIPTION>
					<DESCRIPTION>Water drips somewhere in the dark. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="mine_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="mine_junk" />
		</ROOM>
		<ROOM insert="setpiece_hall_rooms" />
	</ROOM>
</ROOM>

<ROOM id="interior_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='interior' or $roomtag_nodetype='square'">
	<ROOM select="all" condition="$theme='mine' or $theme='random'">
		<ROOM class="CaveRoom">
			<TITLE>a vaulted dig chamber</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Miners carved this great chamber out of the rock. </DESCRIPTION>
					<DESCRIPTION>Heaps of sorted ore fill this cavern. </DESCRIPTION>
					<DESCRIPTION>Bedrolls and a cold firepit mark an old miners' camp. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Lanterns hang from hooks, unlit. </DESCRIPTION>
					<DESCRIPTION>Tools lie where they were dropped. </DESCRIPTION>
					<DESCRIPTION>A rope ladder hangs from a hole above. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="mine_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="mine_junk" />
		</ROOM>
		<ROOM class="CaveRoom">
