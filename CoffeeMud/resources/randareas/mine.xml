				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="mine_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="mine_junk" />
		</ROOM>
	</ROOM>
</ROOM>

<ROOM id="leaf_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='leaf'">
	<ROOM select="all" condition="$theme='mine' or $theme='random'">
		<ROOM class="CaveRoom" condition="$roomtag_isdeepest='true' and $__mineboss&lt;1" define="__mineboss+=1">
			<TITLE>a played-out gallery, the deepest place</TITLE>
			<DESCRIPTION>This gallery was worked until nothing was left. A glint of ore remains in one wall. This is the heart of $areaname. You can go $roomexits_desc_long.</DESCRIPTION>
			<EXIT class="Open" />
			<MOB insert="mine_boss" condition="$pop_mobs!='false'" />
			<ITEM select="any-3" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
		</ROOM>
		<ROOM class="CaveRoom">
			<TITLE>a played-out gallery</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>This gallery was worked until nothing was left. </DESCRIPTION>
					<DESCRIPTION>Dark water fills the bottom of this sump. </DESCRIPTION>
					<DESCRIPTION>The roof has come down here, ending the drift. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A glint of ore remains in one wall. </DESCRIPTION>
					<DESCRIPTION>Something moves under the water. </DESCRIPTION>
					<DESCRIPTION>There is no way on. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="mine_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="mine_junk" />
			<ITEM condition="(1?3=1) and ($pop_items!='false')" select="any-2" insert="dungeon_treasure_items" />
		</ROOM>
		<ROOM class="CaveRoom">
			<TITLE>a flooded sump</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>This gallery was worked until nothing was left. </DESCRIPTION>
					<DESCRIPTION>Dark water fills the bottom of this sump. </DESCRIPTION>
					<DESCRIPTION>The roof has come down here, ending the drift. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A glint of ore remains in one wall. </DESCRIPTION>
					<DESCRIPTION>Something moves under the water. </DESCRIPTION>
					<DESCRIPTION>There is no way on. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="mine_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="mine_junk" />
			<ITEM condition="(1?3=1) and ($pop_items!='false')" select="any-2" insert="dungeon_treasure_items" />
		</ROOM>
		<ROOM class="CaveRoom">
			<TITLE>a collapsed drift</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>This gallery was worked until nothing was left. </DESCRIPTION>
					<DESCRIPTION>Dark water fills the bottom of this sump. </DESCRIPTION>
					<DESCRIPTION>The roof has come down here, ending the drift. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A glint of ore remains in one wall. </DESCRIPTION>
					<DESCRIPTION>Something moves under the water. </DESCRIPTION>
					<DESCRIPTION>There is no way on. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="mine_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="mine_junk" />
			<ITEM condition="(1?3=1) and ($pop_items!='false')" select="any-2" insert="dungeon_treasure_items" />
		</ROOM>
		<ROOM insert="setpiece_leaf_rooms" />
	</ROOM>
</ROOM>

<MOB id="mine_mobs" select="any-1" requires="level_range=int,aggrochance=int">
	<MOB class="GenMob" level="$level_range" race="Kobold" gender="$anygender">
		<NAME>a kobold miner</NAME>
		<DISPLAY>$mob_name chips at the wall with a pick.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Duergar" gender="$anygender">
		<NAME>a duergar prospector</NAME>
		<DISPLAY>$mob_name glares at you from under a heavy brow.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="GiantRat" gender="$anygender">
		<NAME>a giant mine rat</NAME>
		<DISPLAY>$mob_name gnaws at a candle stub.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Bat" gender="$anygender">
		<NAME>a cave bat</NAME>
		<DISPLAY>$mob_name hangs from the ceiling.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
</MOB>

<MOB id="mine_boss" class="GenMob" level="$level_range + 5" race="UmberHulk" gender="$anygender" hpmod="25">
	<NAME>an umber hulk</NAME>
	<DISPLAY>$mob_name claws its way out of the rock.</DISPLAY>
	<BEHAVIOR select="all">
		<BEHAVIOR class="Aggressive" parms="" condition="$aggrochance&gt;0" />
		<BEHAVIOR class="CombatAbilities" parms="" />
	</BEHAVIOR>
	<ITEM select="any-2" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
</MOB>

<ITEM id="mine_junk" select="any-1">
	<ITEM class="GenItem" name="a broken pick" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a lump of iron ore" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a cracked miner's lantern" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a coil of old rope" display="$item_name lies here." level="$level_range" basegold="1?20" />
</ITEM>
