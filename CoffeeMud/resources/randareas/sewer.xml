			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="sewer_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="sewer_junk" />
		</ROOM>
	</ROOM>
</ROOM>

<ROOM id="leaf_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='leaf'">
	<ROOM select="all" condition="$theme='sewer' or $theme='random'">
		<ROOM class="SewerRoom" condition="$roomtag_isdeepest='true' and $__sewerboss&lt;1" define="__sewerboss+=1">
			<TITLE>a blocked outflow, the deepest place</TITLE>
			<DESCRIPTION>A grate blocks the outflow here, choked with refuse. It is a dead end. This is the heart of $areaname. You can go $roomexits_desc_long.</DESCRIPTION>
			<EXIT class="Open" />
			<MOB insert="sewer_boss" condition="$pop_mobs!='false'" />
			<ITEM select="any-3" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
		</ROOM>
		<ROOM class="SewerRoom">
			<TITLE>a blocked outflow</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>A grate blocks the outflow here, choked with refuse. </DESCRIPTION>
					<DESCRIPTION>Gnawed bones and rags fill this stinking nest. </DESCRIPTION>
					<DESCRIPTION>Crates have been hidden in this dry alcove. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>It is a dead end. </DESCRIPTION>
					<DESCRIPTION>Something has been living here. </DESCRIPTION>
					<DESCRIPTION>Someone means to come back for these. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="sewer_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="sewer_junk" />
			<ITEM condition="(1?3=1) and ($pop_items!='false')" select="any-2" insert="dungeon_treasure_items" />
		</ROOM>
		<ROOM class="SewerRoom">
			<TITLE>a rats' nest</TITLE>
			<DESCRIPTION select="all">
