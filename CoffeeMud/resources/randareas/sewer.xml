	</ROOM>
</ROOM>

<MOB id="sewer_mobs" select="any-1" requires="level_range=int,aggrochance=int">
	<MOB class="GenMob" level="$level_range" race="GiantRat" gender="$anygender">
		<NAME>a sewer rat</NAME>
		<DISPLAY>$mob_name swims through the filth.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="DireRat" gender="$anygender">
		<NAME>a dire rat</NAME>
		<DISPLAY>$mob_name bares yellow teeth.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Crocodile" gender="$anygender">
		<NAME>a sewer crocodile</NAME>
		<DISPLAY>$mob_name lies half under the water.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Jelly" gender="$anygender">
		<NAME>a creeping ooze</NAME>
		<DISPLAY>$mob_name slides along the bricks.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
</MOB>

<MOB id="sewer_boss" class="GenMob" level="$level_range + 5" race="WereRat" gender="$anygender" hpmod="25">
	<NAME>the rat king</NAME>
	<DISPLAY>$mob_name sits on a throne of refuse.</DISPLAY>
	<BEHAVIOR select="all">
		<BEHAVIOR class="Aggressive" parms="" condition="$aggrochance&gt;0" />
		<BEHAVIOR class="CombatAbilities" parms="" />
	</BEHAVIOR>
	<ITEM select="any-2" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
</MOB>

<ITEM id="sewer_junk" select="any-1">
	<ITEM class="GenItem" name="a soggy boot" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a rusted grate key" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a stained purse" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a bundle of rags" display="$item_name lies here." level="$level_range" basegold="1?20" />
</ITEM>
