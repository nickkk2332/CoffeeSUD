See guides/RandomAreas.html for information about documents of this type.

G15: the sewer theme, a sewer: channels, cisterns and what lives in the filth below a city.  GENERATE AREA sewer_dungeon FROM randareas/sewer.xml areaname=X
areasize=30 level_range=10 aggrochance=20 theme=sewer; random_dungeon rolls it too.
-->
<string id="randomtheme" merge="true" select="any-1">
	<string condition="$theme=''">sewer</string>
</string>
<STRING load="/resources/randareas/inc_roomruns.xml" />
<STRING load="/resources/randareas/inc_common.xml" />
<STRING load="/resources/randareas/inc_adjectives.xml" />
<STRING load="/resources/randareas/inc_setpieces.xml" />

<!-- the theme's own area: its layout picked from the list (G16), its name once in requires -->
<AREA id="sewer_dungeon" layout="GRIDCITY,MAZE,CROSS,LINEAR,TREE" requires="areaname=$,areasize=int,level_range=int,aggrochance=int,theme=sewer">
	<NAME>$areaname</NAME><SIZE>$areasize</SIZE>
	<CLASS select="any-1"><CLASS condition="$areatype!=''">$areatype</CLASS><CLASS condition="$areatype=''">StdArea</CLASS></CLASS>
	<ROOM insert="hallway_rooms,interior_rooms,leaf_rooms" />
</AREA>
<AREA id="random_dungeon" merge="true" insert="sewer_dungeon" />

<ROOM id="hallway_rooms" merge="true" select="pick-1" condition="$roomtag_nodetype='street' or $roomtag_nodetype='surround'">
	<ROOM select="all" condition="$theme='sewer' or $theme='random'">
		<ROOM class="SewerRoom">
			<TITLE>a sewer channel</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Filthy water runs along this brick channel. </DESCRIPTION>
					<DESCRIPTION>A narrow walkway, slick with slime, runs beside the flow. </DESCRIPTION>
					<DESCRIPTION>You have to stoop in this low culvert. </DESCRIPTION>
					<DESCRIPTION>Grates above let in a little light from the streets. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The smell is $adj_smelly beyond words. </DESCRIPTION>
					<DESCRIPTION>Rats squeak somewhere close. </DESCRIPTION>
					<DESCRIPTION>Refuse drifts past on the current. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="sewer_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="sewer_junk" />
		</ROOM>
		<ROOM class="SewerRoom">
			<TITLE>a slime-slick walkway</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Filthy water runs along this brick channel. </DESCRIPTION>
					<DESCRIPTION>A narrow walkway, slick with slime, runs beside the flow. </DESCRIPTION>
					<DESCRIPTION>You have to stoop in this low culvert. </DESCRIPTION>
					<DESCRIPTION>Grates above let in a little light from the streets. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The smell is $adj_smelly beyond words. </DESCRIPTION>
					<DESCRIPTION>Rats squeak somewhere close. </DESCRIPTION>
					<DESCRIPTION>Refuse drifts past on the current. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="sewer_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="sewer_junk" />
		</ROOM>
		<ROOM class="SewerRoom">
			<TITLE>a low culvert</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Filthy water runs along this brick channel. </DESCRIPTION>
					<DESCRIPTION>A narrow walkway, slick with slime, runs beside the flow. </DESCRIPTION>
					<DESCRIPTION>You have to stoop in this low culvert. </DESCRIPTION>
					<DESCRIPTION>Grates above let in a little light from the streets. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The smell is $adj_smelly beyond words. </DESCRIPTION>
					<DESCRIPTION>Rats squeak somewhere close. </DESCRIPTION>
					<DESCRIPTION>Refuse drifts past on the current. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="sewer_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="sewer_junk" />
		</ROOM>
		<ROOM insert="setpiece_hall_rooms" />
	</ROOM>
</ROOM>

<ROOM id="interior_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='interior' or $roomtag_nodetype='square'">
	<ROOM select="all" condition="$theme='sewer' or $theme='random'">
		<ROOM class="SewerRoom">
			<TITLE>an overflow cistern</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Several channels empty into this great cistern. </DESCRIPTION>
					<DESCRIPTION>Tunnels meet at this junction under a vaulted roof. </DESCRIPTION>
					<DESCRIPTION>Old pumps and pipes fill this vaulted room. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>The water here is deep and still. </DESCRIPTION>
					<DESCRIPTION>Someone has scratched marks on the walls. </DESCRIPTION>
					<DESCRIPTION>Pipes groan and drip. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="sewer_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="sewer_junk" />
		</ROOM>
