See guides/RandomAreas.html for information about documents of this type.

G15: the ruins theme, ruins: fallen temples and crumbled cities, picked over by scavengers.  GENERATE AREA ruins_dungeon FROM randareas/ruins.xml areaname=X
areasize=30 level_range=10 aggrochance=20 theme=ruins; random_dungeon rolls it too.
-->
<string id="randomtheme" merge="true" select="any-1">
	<string condition="$theme=''">ruins</string>
</string>
<STRING load="/resources/randareas/inc_roomruns.xml" />
<STRING load="/resources/randareas/inc_common.xml" />
<STRING load="/resources/randareas/inc_adjectives.xml" />
<STRING load="/resources/randareas/inc_setpieces.xml" />

<!-- the theme's own area: its layout picked from the list (G16), its name once in requires -->
<AREA id="ruins_dungeon" layout="SPOTTEDMESH,GRIDCITY,CROSS,CLUMP,ISLANDS" requires="areaname=$,areasize=int,level_range=int,aggrochance=int,theme=ruins">
	<NAME>$areaname</NAME><SIZE>$areasize</SIZE>
	<CLASS select="any-1"><CLASS condition="$areatype!=''">$areatype</CLASS><CLASS condition="$areatype=''">StdArea</CLASS></CLASS>
	<ROOM insert="hallway_rooms,interior_rooms,leaf_rooms" />
</AREA>
<AREA id="random_dungeon" merge="true" insert="ruins_dungeon" />

<ROOM id="hallway_rooms" merge="true" select="pick-1" condition="$roomtag_nodetype='street' or $roomtag_nodetype='surround'">
	<ROOM select="all" condition="$theme='ruins' or $theme='random'">
		<ROOM class="StoneRoom">
			<TITLE>a crumbled colonnade</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Broken columns line what was once a grand avenue. </DESCRIPTION>
					<DESCRIPTION>Rubble chokes this old street, and weeds push through the paving. </DESCRIPTION>
					<DESCRIPTION>A gateway lies toppled across the way, its carvings worn away. </DESCRIPTION>
					<DESCRIPTION>Vines have pulled down most of the walls here. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Lizards bask on the warm stones. </DESCRIPTION>
					<DESCRIPTION>Scavengers have left their marks in the dust. </DESCRIPTION>
					<DESCRIPTION>Old inscriptions can just be made out. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?3=1) and ($pop_mobs!='false')" select="any-1" insert="ruins_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="ruins_junk" />
		</ROOM>
		<ROOM class="StoneRoom">
			<TITLE>a rubble-strewn avenue</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION condition="$ROOMTAG_NODEGATEEXIT != ''">You are at the way into $areaname. </DESCRIPTION>
				<DESCRIPTION select="any-1">
