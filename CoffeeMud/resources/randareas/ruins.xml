					<DESCRIPTION>An old offering bowl sits on the altar. </DESCRIPTION>
					<DESCRIPTION>Rubble blocks any way further. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="ruins_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="ruins_junk" />
			<ITEM condition="(1?3=1) and ($pop_items!='false')" select="any-2" insert="dungeon_treasure_items" />
		</ROOM>
		<ROOM class="StoneRoom">
			<TITLE>a sunken crypt</TITLE>
