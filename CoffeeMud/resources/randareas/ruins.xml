	</ROOM>
</ROOM>

<MOB id="ruins_mobs" select="any-1" requires="level_range=int,aggrochance=int">
	<MOB class="GenMob" level="$level_range" race="Human" gender="$anygender">
		<NAME>a ragged bandit</NAME>
		<DISPLAY>$mob_name is picking through the rubble.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="GiantSpider" gender="$anygender">
		<NAME>(a(n)) $adj_insect_color giant spider</NAME>
		<DISPLAY>$mob_name waits in its web.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Snake" gender="$anygender">
		<NAME>(a(n)) $adj_reptile_color viper</NAME>
		<DISPLAY>$mob_name coils between the stones.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
	<MOB class="GenMob" level="$level_range" race="Gnoll" gender="$anygender">
		<NAME>a scavenging gnoll</NAME>
		<DISPLAY>$mob_name sniffs the air here.</DISPLAY>
		<BEHAVIOR select="all">
			<BEHAVIOR condition="1?100&lt;$aggrochance" class="Aggressive" parms="" />
			<BEHAVIOR class="Mobile" parms="" condition="$roomtag_nodetype!='leaf'" />
			<BEHAVIOR class="CombatAbilities" parms="" />
		</BEHAVIOR>
	</MOB>
</MOB>

<MOB id="ruins_boss" class="GenMob" level="$level_range + 5" race="Human" gender="$anygender" hpmod="25">
	<NAME>a grim necromancer</NAME>
	<DISPLAY>$mob_name chants over a circle of bones.</DISPLAY>
	<BEHAVIOR select="all">
		<BEHAVIOR class="Aggressive" parms="" condition="$aggrochance&gt;0" />
		<BEHAVIOR class="CombatAbilities" parms="" />
	</BEHAVIOR>
	<ITEM select="any-2" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
</MOB>

<ITEM id="ruins_junk" select="any-1">
	<ITEM class="GenItem" name="a broken statue hand" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a chipped mosaic tile" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a rusted temple bell" display="$item_name lies here." level="$level_range" basegold="1?20" />
	<ITEM class="GenItem" name="a fragment of an old map" display="$item_name lies here." level="$level_range" basegold="1?20" />
</ITEM>
