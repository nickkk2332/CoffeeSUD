<ROOM id="leaf_rooms" merge="true" select="any-1" condition="$roomtag_nodetype='leaf'">
	<ROOM select="all" condition="$theme='ruins' or $theme='random'">
		<ROOM class="StoneRoom" condition="$roomtag_isdeepest='true' and $__ruinsboss&lt;1" define="__ruinsboss+=1">
			<TITLE>a buried shrine, the deepest place</TITLE>
			<DESCRIPTION>Half buried in earth, this small shrine is still intact. Little of value seems left. This is the heart of $areaname. You can go $roomexits_desc_long.</DESCRIPTION>
			<EXIT class="Open" />
			<MOB insert="ruins_boss" condition="$pop_mobs!='false'" />
			<ITEM select="any-3" insert="dungeon_treasure_items" condition="$pop_items!='false'" />
		</ROOM>
		<ROOM class="StoneRoom">
			<TITLE>a buried shrine</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Half buried in earth, this small shrine is still intact. </DESCRIPTION>
					<DESCRIPTION>The treasury's doors were broken in long ago. </DESCRIPTION>
					<DESCRIPTION>Steps lead down into this sunken, $adj_mustydark crypt. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Little of value seems left. </DESCRIPTION>
					<DESCRIPTION>An old offering bowl sits on the altar. </DESCRIPTION>
					<DESCRIPTION>Rubble blocks any way further. </DESCRIPTION>
				</DESCRIPTION>
				<DESCRIPTION select="any-1"><DESCRIPTION>Ways lead $roomexits_desc_long.</DESCRIPTION><DESCRIPTION>You can go $roomexits_desc_long.</DESCRIPTION></DESCRIPTION>
			</DESCRIPTION>
			<EXIT class="Open" />
			<MOB condition="(1?2=1) and ($pop_mobs!='false')" select="any-1" insert="ruins_mobs" />
			<ITEM condition="(1?4=1) and ($pop_items!='false')" select="any-1" insert="ruins_junk" />
			<ITEM condition="(1?3=1) and ($pop_items!='false')" select="any-2" insert="dungeon_treasure_items" />
		</ROOM>
		<ROOM class="StoneRoom">
			<TITLE>a looted treasury</TITLE>
			<DESCRIPTION select="all">
				<DESCRIPTION select="any-1">
					<DESCRIPTION>Half buried in earth, this small shrine is still intact. </DESCRIPTION>
					<DESCRIPTION>The treasury's doors were broken in long ago. </DESCRIPTION>
					<DESCRIPTION>Steps lead down into this sunken, $adj_mustydark crypt. </DESCRIPTION>
				</DESCRIPTION>
